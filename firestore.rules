rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Applications submitted from the "Work with us" page.
    // Anyone can submit a well-formed application (create-only).
    // Nobody can read, edit, or delete from the client — only visible
    // to project owners/editors via the Firebase console or Admin SDK.
    match /applications/{applicationId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'linkedin', 'position', 'message', 'createdAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() < 50 &&
        request.resource.data.linkedin is string &&
        request.resource.data.linkedin.size() < 300 &&
        request.resource.data.position is string &&
        request.resource.data.position.size() < 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() < 5000 &&
        request.resource.data.createdAt == request.time;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
